# Persistence / browser access
COMMERCEBRIDGE_DB=data/commercebridge.db
CORS_ORIGINS=http://localhost:5173,https://commercebridge-integrations.vercel.app

# Shopify webhook verification (app client secret)
SHOPIFY_WEBHOOK_SECRET=replace-me

# Shopify Admin GraphQL reconciliation
SHOPIFY_SHOP_DOMAIN=your-development-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_replace-me
SHOPIFY_API_VERSION=2026-07

# Public backend URL used by the webhook registration helper
COMMERCEBRIDGE_PUBLIC_URL=https://your-api.example.com

# Optional real ERP endpoint. If omitted, CommerceBridge uses its deterministic demo gateway.
ERP_BASE_URL=
ERP_API_KEY=
