# Persistence / browser access
COMMERCEBRIDGE_DB=data/commercebridge.db
CORS_ORIGINS=http://localhost:5173,https://commercebridge-integrations.vercel.app

# Shopify development store + Dev Dashboard app
SHOPIFY_SHOP_DOMAIN=your-development-store.myshopify.com
SHOPIFY_CLIENT_ID=replace-me
SHOPIFY_CLIENT_SECRET=replace-me
SHOPIFY_API_VERSION=2026-07

# Optional: use a pre-generated Admin API token instead of client credentials.
# If omitted, CommerceBridge requests a 24-hour token automatically.
SHOPIFY_ACCESS_TOKEN=

# Optional explicit webhook HMAC secret. If omitted, SHOPIFY_CLIENT_SECRET is used.
SHOPIFY_WEBHOOK_SECRET=

# HTTPS tunnel / public backend URL. Used by POST /shopify/setup/webhook.
COMMERCEBRIDGE_PUBLIC_URL=https://your-tunnel.example.com

# Optional real ERP endpoint. If omitted, deterministic ERP simulator is used.
ERP_BASE_URL=
ERP_API_KEY=
